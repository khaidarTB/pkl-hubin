APP_NAME=PKLConnect
APP_ENV=local
APP_KEY=base64:8rqJEqkXa8ETV0WHUHAPjsJ5G2/qJ4Ou8OagU48q0kA=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pklconnect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pklconnect.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

AI_API_KEY=
# Nexa AI hanya memakai satu model: Gemini 3 Flash (konteks input 1M token).
AI_MODEL=gemini-3-flash-preview
# Fallback model dinonaktifkan (dibiarkan kosong).
GEMINI_FALLBACK_MODELS=
WA_GATEWAY_STATUS=connected

# Smart Geo-Attendance
# Radius default (meter) untuk validasi absensi jika perusahaan tidak menentukan radius.
ATTENDANCE_DEFAULT_RADIUS=100
# Ambang akurasi GPS (meter). Lebih kecil = lebih ketat.
MAX_GPS_ACCURACY=50
# Jendela waktu absensi masuk (Asia/Jakarta, format HH:MM).
ATTENDANCE_START_AT=06:30
# Batas waktu dianggap TEPAT WAKTU (HH:MM).
ATTENDANCE_ON_TIME_UNTIL=08:00
# Batas akhir jendela absensi masuk (HH:MM).
ATTENDANCE_END_AT=09:00
